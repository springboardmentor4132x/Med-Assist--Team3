# Application
APP_NAME=MedAssist AI Authentication Service
ENVIRONMENT=development
DEBUG=true

# Database (PostgreSQL in production/Docker, SQLite fallback in local dev)
# Example PostgreSQL: postgresql+psycopg://medassist:medassist_secret@localhost:5432/medassist
DATABASE_URL=sqlite:///./medassist_auth.db

# JWT Security (MUST set a strong random secret in production)
JWT_SECRET_KEY=change-this-to-a-strong-random-secret-in-production-32bytes-min
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Account Lockout & Rate Limiting
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15
LOGIN_RATE_LIMIT_MAX_REQUESTS=20
LOGIN_RATE_LIMIT_WINDOW_SECONDS=60

# CORS
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000

# Development Demo Accounts (never enable in production)
SEED_DEMO_USERS=true

